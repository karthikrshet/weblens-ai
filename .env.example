# WebLens AI Environment Configuration

APP_NAME="WebLens AI"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/api/v1"

# Database Configuration (Defaults to SQLite for local development; switch to postgresql for production)
DATABASE_URL="sqlite:///./weblens.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/weblens"

# Security & Limits
MAX_PAGES_PER_WEBSITE=20
MAX_CRAWL_DEPTH=2
MAX_RESPONSE_BYTES=5242880
REQUEST_TIMEOUT_SECONDS=15.0
TOTAL_CRAWL_TIMEOUT_SECONDS=60.0
MAX_TOOL_CALLS=8

# LLM Providers (mock, openai, gemini, grok, anthropic)
LLM_PROVIDER="mock"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# xAI Grok
XAI_API_KEY=""
GROK_MODEL="grok-beta"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Embeddings
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
